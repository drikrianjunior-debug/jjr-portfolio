# --- Base de données Neon (API) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Sécurité API ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=8787

# Origines autorisées (CORS) — URL(s) du front en production, séparées par des virgules
CLIENT_ORIGIN=http://localhost:5173,https://ton-projet.vercel.app

# --- Compte admin (uniquement pour npm run admin:create) ---
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=change-me-to-a-long-unique-passphrase

# --- Front (Vite) — à définir aussi sur Vercel ---
# En local laisser vide (proxy Vite). En prod : URL publique de l'API (Render/Railway)
# VITE_API_URL=https://ton-api.onrender.com
